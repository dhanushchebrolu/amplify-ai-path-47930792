    "SUPABASE_URL": "https://kcjsfwnzlwcnucfkesgh.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_2_nTOb1FIsyYbTr-Q8a6pA_WpnjAetq",
    "SUPABASE_PROJECT_ID": "kcjsfwnzlwcnucfkesgh"
  }
}
