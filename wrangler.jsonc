{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-blaze",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Source entry for the Cloudflare Vite plugin, not a deployable bundle: it
  // imports TanStack Start virtual modules (#tanstack-start-entry, …) that only
  // `vite build` resolves. `vite build` writes dist/server/wrangler.json and the
  // gitignored .wrangler/deploy/config.json redirect that `wrangler deploy`
  // follows. Always deploy with `bun run deploy` (build, then deploy); a bare
  // `wrangler deploy` in a fresh clone bundles this file and fails.
  "main": "src/server.ts",
  // Mirrors the existing remote Worker settings so `wrangler deploy` keeps
  // them instead of overriding them.
  "routes": [{ "pattern": "aiblaze.io", "zone_name": "aiblaze.io", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // Non-secret, publishable Supabase config. These MUST be present on the
  // Worker: every SSR loader/server function reads them via
  // src/config/env.server.ts (requireServerEnv). Without them the category
  // detail pages and /compare throw during SSR and return 500.
  "vars": {
    "SUPABASE_URL": "https://vcijromdouxsymmglrha.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_xPn3UHFf5kOLcKM11wjvZA__5NO3gbo",
    "SUPABASE_PROJECT_ID": "vcijromdouxsymmglrha"
  }
}
